# --- Supabase -------------------------------------------------------------
# Panel del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Llave secreta service_role — SOLO servidor (cron, push, scripts). Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# --- Cron (reinicio semanal) --------------------------------------------
# Token compartido que Vercel Cron / Supabase Scheduled Function envía en el header
# Authorization: Bearer <CRON_SECRET> al llamar /api/cron/reinicio-semanal
CRON_SECRET=genera-un-token-aleatorio-largo

# --- Web Push (VAPID) ---------------------------------------------------
# Genera el par con:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@baraja2.app

# --- App --------------------------------------------------------------
NEXT_PUBLIC_URL_BASE=http://localhost:3000
